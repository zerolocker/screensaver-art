# Secrets for the nightly curation. Copy to curation/.env (gitignored) and fill in.
# Commands load them through curation/with-secrets.sh, e.g.
#   bash curation/with-secrets.sh GEMINI_API_KEY -- python .claude/skills/nano-banana-pro/scripts/generate.py …

# Google Gemini: image, video and music generation. Required.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides:
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# VEO_MODEL=veo-3.1-generate-preview

# Cloudflare API token with R2 read/write on the `screensaver-assets` bucket. Required.
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
# Only if the token spans several accounts:
# CLOUDFLARE_ACCOUNT_ID=

# Zernio, for the nightly social post (marketing/post-social.mjs). Without it the
# art still publishes; only the post is skipped. Check it with:
#   bash curation/with-secrets.sh ZERNIO_API_KEY -- node marketing/post-social.mjs --check
ZERNIO_API_KEY=

# Optional: Pinterest board name or id (default "Daily Curation").
# PINTEREST_BOARD=
